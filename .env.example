# Copy to .env and fill in. .env is git-ignored. Real environment variables override this file.
# Every setting is optional; defaults live in config/defaults.json. Full list: docs/CONFIGURATION.md

# Free app id from https://register.inboxsdk.com/ (label: 5-15 letters/digits).
# Without it the extension works, but Gmail shows a red "Invalid AppId" banner.
INBOXSDK_APP_ID=

# Branding
# APP_NAME=Gmail Plus
# APP_SHORT_NAME=Gmail Plus
# APP_SLUG=gmail-plus
# APP_DESCRIPTION=Quick-reply templates, a light pipeline, follow-up reminders, contact export and mail merge inside Gmail. Runs locally.
# SUPPORT_EMAIL=
# HOMEPAGE_URL=https://github.com/Round24Consult/gmail-plus
# PRIVACY_POLICY_URL=

# Mail merge limits
# MERGE_DEFAULT_DAILY_CAP=100
# MERGE_MAX_DAILY_CAP=400
# MERGE_DEFAULT_INTERVAL_SEC=30
# MERGE_MIN_INTERVAL_SEC=10
# MERGE_MAX_INTERVAL_SEC=600
# MERGE_MAX_RECIPIENTS=2000

# Follow-ups
# FOLLOW_UP_SWEEP_MINUTES=15
# FOLLOW_UP_REMINDER_HOUR=9

# Playbooks: which playbooks/*.json files to bundle, and which are on at first run (empty = all)
# PLAYBOOKS=freelancer,recruiter,support
# DEFAULT_PLAYBOOKS=
