{
  "manifest_version": 3,
  "name": "%APP_NAME%",
  "short_name": "%APP_SHORT_NAME%",
  "version": "0.0.0",
  "description": "%APP_DESCRIPTION%",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "%APP_NAME%",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "gp.css"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://mail.google.com/"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.svg",
        "icons/*.png"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}
