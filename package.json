{
  "name": "gmail-plus",
  "version": "0.3.0",
  "description": "Open-source Chrome extension that adds reply templates, a configurable pipeline, follow-ups, contact export, mail merge and WhatsApp follow-ups to Gmail.",
  "author": "Round24 Consult",
  "license": "MIT",
  "homepage": "https://github.com/Round24Consult/gmail-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Round24Consult/gmail-plus.git"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "build:prod": "node build.mjs --prod",
    "package": "node build.mjs --prod && node scripts/package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@inboxsdk/core": "^2.2.35",
    "kefir": "^3.8.8",
    "libphonenumber-js": "^1.13.16",
    "papaparse": "^5.7.1",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/papaparse": "^5.5.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "gmail",
    "chrome-extension",
    "inboxsdk",
    "mail-merge",
    "crm",
    "templates",
    "whatsapp"
  ]
}
