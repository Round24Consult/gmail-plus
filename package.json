{
  "name": "gmail-plus",
  "version": "0.1.0",
  "description": "Templates, a light pipeline, follow-ups, CSV export and mail merge inside Gmail.",
  "author": "Round24 Consult",
  "license": "UNLICENSED",
  "homepage": "https://github.com/Round24Consult/gmail-plus#readme",
  "repository": {
